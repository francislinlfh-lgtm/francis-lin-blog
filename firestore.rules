rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anonymous per-post view counter. Each doc holds a single integer `count`.
    // Anyone may read it and may only create it at 1 or bump it by exactly 1 —
    // nothing else is writable, so it can't be abused for arbitrary data.
    match /postViews/{id} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && (
          (resource == null && request.resource.data.count == 1) ||
          (resource != null && request.resource.data.count == resource.data.count + 1)
        );
    }
  }
}
